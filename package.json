{
  "name": "google-finance-news-crawler",
  "version": "2.0.0",
  "description": "Elegant tool for crawling historical news data from Google Finance",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "gfn-crawler": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "crawl": "node src/cli.js crawl",
    "convert": "node src/cli.js convert",
    "validate": "node src/cli.js validate",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"*.md\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --maxWorkers=2",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules coverage dist *.log",
    "clean:output": "rm -rf output/*.js pandora.json",
    "prebuild": "npm run lint && npm run test",
    "docs:generate": "jsdoc -c jsdoc.json",
    "security:audit": "npm audit --production",
    "security:fix": "npm audit fix"
  },
  "keywords": [
    "google-finance",
    "news-crawler",
    "web-scraper",
    "financial-data",
    "data-mining",
    "news-aggregation"
  ],
  "author": "Van-Duyet Le",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyetdev/google-finance-news-crawler.git"
  },
  "bugs": {
    "url": "https://github.com/duyetdev/google-finance-news-crawler/issues"
  },
  "homepage": "https://github.com/duyetdev/google-finance-news-crawler#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "ora": "^8.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.9.0",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/cli.js",
      "!**/__tests__/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 77,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "transform": {}
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
