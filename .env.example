# Google Finance News Crawler Configuration

# Google Finance API Tokens
# Get these from Google Finance using browser DevTools
GF_CID=4592563
GF_EI=y-xVWLGBJImv0ASYibfABg

# Date Range
# Format: YYYY-MM-DD
START_DATE=2011-06-24
END_DATE=2025-11-16

# Output Settings
OUTPUT_DIR=output
OUTPUT_FILE=pandora.json

# Crawler Settings
# Delay between requests in milliseconds (respect rate limits)
DELAY=1000

# Maximum number of retries for failed requests
MAX_RETRIES=4

# Converter Settings
# Set to 'false' to disable
VALIDATE=true
DEDUPLICATE=true
SORT=true

# Logging
# Options: error, warn, info, debug
LOG_LEVEL=info
